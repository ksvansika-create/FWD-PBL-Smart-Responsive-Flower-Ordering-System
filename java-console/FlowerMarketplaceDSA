    // ══════════════════════════════════════════════════════════════════════
    //  ⑤ BUBBLE SORT — Sort Products by Price (Ascending)
    //  (Like sorting your products grid by lowest price first)
    // ══════════════════════════════════════════════════════════════════════

    static Product[] bubbleSort(Product[] arr) {
        Product[] a = arr.clone();
        int n = a.length, passes = 0, swaps = 0;
        for (int i = 0; i < n - 1; i++) {
            boolean swapped = false;
            for (int j = 0; j < n - i - 1; j++) {
                if (a[j].priceInt > a[j+1].priceInt) {
                    Product tmp = a[j]; a[j] = a[j+1]; a[j+1] = tmp;
                    swapped = true; swaps++;
                }
            }
            passes++;
            if (!swapped) break;  // early exit optimisation
        }
        System.out.printf("  ℹ  Bubble Sort: %d passes, %d swaps%n", passes, swaps);
        return a;
    }

    // ══════════════════════════════════════════════════════════════════════
    //  ⑥ MERGE SORT — Sort Products by Name (Alphabetical)
    //  (Like sorting your products grid A→Z)
    // ══════════════════════════════════════════════════════════════════════

    static Product[] mergeSort(Product[] arr) {
        if (arr.length <= 1) return arr;
        int mid = arr.length / 2;
        Product[] left  = mergeSort(Arrays.copyOfRange(arr, 0, mid));
        Product[] right = mergeSort(Arrays.copyOfRange(arr, mid, arr.length));
        return merge(left, right);
    }

    static Product[] merge(Product[] l, Product[] r) {
        Product[] result = new Product[l.length + r.length];
        int i = 0, j = 0, k = 0;
        while (i < l.length && j < r.length)
            result[k++] = l[i].name.compareToIgnoreCase(r[j].name) <= 0 ? l[i++] : r[j++];
        while (i < l.length)  result[k++] = l[i++];
        while (j < r.length)  result[k++] = r[j++];
        return result;
    }

    // ══════════════════════════════════════════════════════════════════════
    //  ⑦ BINARY SEARCH — Find Product by Exact Price in Sorted Array
    //  (After bubble sort, instantly find all products at a given price)
    // ══════════════════════════════════════════════════════════════════════

    static int binarySearch(Product[] sorted, int targetPrice) {
        int lo = 0, hi = sorted.length - 1, steps = 0;
        while (lo <= hi) {
            int mid = (lo + hi) / 2;
            steps++;
            System.out.printf("  Step %d: checking index %d → %s (%s)%n",
                steps, mid, sorted[mid].name, sorted[mid].price);
            if      (sorted[mid].priceInt == targetPrice) { System.out.println("  ✅ Found at index " + mid + " in " + steps + " steps!"); return mid; }
            else if (sorted[mid].priceInt <  targetPrice)  lo = mid + 1;
            else                                            hi = mid - 1;
        }
        System.out.println("  ❌ No product found at price ₹" + targetPrice + " (" + steps + " steps).");
        return -1;
    }

    // ══════════════════════════════════════════════════════════════════════
    //  ⑧ BINARY SEARCH TREE (BST) — Products Indexed by Price
    //  (Efficient range queries: "show all flowers between ₹400–₹700")
    // ══════════════════════════════════════════════════════════════════════

    static class BSTNode {
        Product data;
        BSTNode left, right;
        BSTNode(Product p) { data = p; }
    }

    static class ProductBST {
        BSTNode root;

        void insert(Product p) { root = insert(root, p); }

        BSTNode insert(BSTNode node, Product p) {
            if (node == null) return new BSTNode(p);
            if      (p.priceInt < node.data.priceInt) node.left  = insert(node.left,  p);
            else if (p.priceInt > node.data.priceInt) node.right = insert(node.right, p);
            // equal prices: insert right
            else node.right = insert(node.right, p);
            return node;
        }

        // In-order = sorted by price (cheapest first)
        void inorder(BSTNode node, List<Product> result) {
            if (node == null) return;
            inorder(node.left, result);
            result.add(node.data);
            inorder(node.right, result);
        }

        List<Product> getSorted() {
            List<Product> list = new ArrayList<>();
            inorder(root, list);
            return list;
        }

        // Range query: find products within [minPrice, maxPrice]
        List<Product> rangeQuery(int minPrice, int maxPrice) {
            List<Product> result = new ArrayList<>();
            rangeQuery(root, minPrice, maxPrice, result);
            return result;
        }

        void rangeQuery(BSTNode node, int min, int max, List<Product> result) {
            if (node == null) return;
            if (node.data.priceInt > min)  rangeQuery(node.left,  min, max, result);
            if (node.data.priceInt >= min && node.data.priceInt <= max) result.add(node.data);
            if (node.data.priceInt < max)  rangeQuery(node.right, min, max, result);
        }

        void printInorder() {
            System.out.println("\n  🌳  BST In-order Traversal (Price Low → High)");
            System.out.println("  " + "─".repeat(65));
            List<Product> sorted = getSorted();
            int i = 1;
            for (Product p : sorted) p.print(i++);
        }
    }

    // ══════════════════════════════════════════════════════════════════════
    //  ⑨ MIN-HEAP — Cheapest Flower Priority Queue
    //  (Like a "deals" section: always show cheapest flower first)
    // ══════════════════════════════════════════════════════════════════════

    static class FlowerMinHeap {
        // Java's PriorityQueue is a min-heap by default
        PriorityQueue<Product> heap = new PriorityQueue<>();

        void insert(Product p) {
            heap.add(p);
            System.out.println("  ➕ Inserted into heap: " + p.name + " " + p.price);
        }

        Product getCheapest() {
            if (heap.isEmpty()) { System.out.println("  📭 Heap is empty."); return null; }
            Product p = heap.peek();
            System.out.println("  💰 Cheapest flower: " + p.name + " at " + p.price);
            return p;
        }

        Product extractCheapest() {
            if (heap.isEmpty()) { System.out.println("  📭 Heap is empty."); return null; }
            Product p = heap.poll();
            System.out.println("  📤 Extracted cheapest: " + p.name + " " + p.price);
            return p;
        }

        void printDeals() {
            System.out.println("\n  💰  Best Deals — Min-Heap (cheapest first)  (size=" + heap.size() + ")");
            System.out.println("  " + "─".repeat(65));
            // drain a copy so we don't destroy the heap
            PriorityQueue<Product> copy = new PriorityQueue<>(heap);
            int rank = 1;
            while (!copy.isEmpty()) {
                Product p = copy.poll();
                System.out.printf("  #%-3d %-28s %-8s  [%s]%n", rank++, p.name, p.price, p.category);
            }
        }
    }

    // ══════════════════════════════════════════════════════════════════════
    //  ⑩ GRAPH + BFS / DFS — Category Relationship Traversal
    //  (Models how your website's categories are related:
    //   Bouquet → Basket → Wreath → Vase → Garland → Centerpiece)
    // ══════════════════════════════════════════════════════════════════════

    static class CategoryGraph {
        Map<String, List<String>> adj = new LinkedHashMap<>();

        void addEdge(String from, String to) {
            adj.computeIfAbsent(from, k -> new ArrayList<>()).add(to);
            adj.computeIfAbsent(to,   k -> new ArrayList<>()).add(from);
        }

        // BFS — find shortest path between two categories
        List<String> bfs(String start) {
            List<String> visited = new ArrayList<>();
            Set<String>  seen    = new LinkedHashSet<>();
            Queue<String> queue  = new LinkedList<>();
            queue.add(start); seen.add(start);
            System.out.println("\n  🔵 BFS from \"" + start + "\":");
            while (!queue.isEmpty()) {
                String node = queue.poll();
                visited.add(node);
                System.out.println("    ➜ Visited: " + node);
                for (String neighbour : adj.getOrDefault(node, new ArrayList<>())) {
                    if (!seen.contains(neighbour)) { seen.add(neighbour); queue.add(neighbour); }
                }
            }
            return visited;
        }

        // DFS — explore all related categories recursively
        List<String> dfs(String start) {
            List<String> visited = new ArrayList<>();
            Set<String>  seen    = new LinkedHashSet<>();
            System.out.println("\n  🟣 DFS from \"" + start + "\":");
            dfsHelper(start, seen, visited);
            return visited;
        }

        void dfsHelper(String node, Set<String> seen, List<String> visited) {
            seen.add(node); visited.add(node);
            System.out.println("    ➜ Visited: " + node);
            for (String neighbour : adj.getOrDefault(node, new ArrayList<>())) {
                if (!seen.contains(neighbour)) dfsHelper(neighbour, seen, visited);
            }
        }

        void printAdjacency() {
            System.out.println("\n  🕸  Category Graph — Adjacency List");
            System.out.println("  " + "─".repeat(50));
            for (Map.Entry<String, List<String>> e : adj.entrySet())
                System.out.println("  " + e.getKey() + " ── " + e.getValue());
        }
    }

