    // ── Demo 5: Bubble Sort ────────────────────────────────────────────────

    static void demoBubbleSort() {
        header("⑤ BUBBLE SORT — Sort by Price (Low → High)");
        System.out.println("  ► Like clicking 'Price: Low to High' filter on products page.\n");

        List<Product> all = catalog.toList();
        Product[] arr = all.toArray(new Product[0]);

        System.out.println("  Before sorting:");
        for (int i = 0; i < arr.length; i++) arr[i].print(i + 1);

        System.out.println("\n  Sorting...");
        Product[] sorted = bubbleSort(arr);

        System.out.println("\n  After Bubble Sort (price low → high):");
        for (int i = 0; i < sorted.length; i++) sorted[i].print(i + 1);

        System.out.println("\n  📊 Time Complexity: Best O(n), Average/Worst O(n²)");
        System.out.println("     Space: O(1) — in-place");
    }

    // ── Demo 6: Merge Sort ─────────────────────────────────────────────────

    static void demoMergeSort() {
        header("⑥ MERGE SORT — Sort by Name (A → Z)");
        System.out.println("  ► Like clicking 'Name: A to Z' filter on products page.\n");

        List<Product> all = catalog.toList();
        Product[] arr = all.toArray(new Product[0]);

        System.out.println("  Before sorting:");
        for (int i = 0; i < arr.length; i++) arr[i].print(i + 1);

        System.out.println("\n  Sorting...");
        Product[] sorted = mergeSort(arr);

        System.out.println("\n  After Merge Sort (name A → Z):");
        for (int i = 0; i < sorted.length; i++) sorted[i].print(i + 1);

        System.out.println("\n  📊 Time Complexity: Best/Average/Worst O(n log n)");
        System.out.println("     Space: O(n) — needs auxiliary arrays");
    }

    // ── Demo 7: Binary Search ──────────────────────────────────────────────

    static void demoBinarySearch() {
        header("⑦ BINARY SEARCH — Find Product by Exact Price");
        System.out.println("  ► First sort the array (bubble sort), then binary search.\n");

        List<Product> all = catalog.toList();
        Product[] arr = all.toArray(new Product[0]);
        Product[] sorted = bubbleSort(arr);

        System.out.println("  Sorted catalog:");
        for (int i = 0; i < sorted.length; i++) sorted[i].print(i + 1);

        System.out.println("\n  ► Searching for price ₹599:");
        int idx = binarySearch(sorted, 599);
        if (idx != -1) sorted[idx].printDetail();

        System.out.println("\n  ► Searching for price ₹849:");
        idx = binarySearch(sorted, 849);
        if (idx != -1) sorted[idx].printDetail();

        System.out.println("\n  ► Searching for price ₹999 (not listed):");
        binarySearch(sorted, 999);

        System.out.println("\n  📊 Time Complexity: O(log n)  |  Space: O(1)");
        System.out.println("     (Linear search O(n) → Binary search O(log n) — " +
            (int)Math.ceil(Math.log(sorted.length)/Math.log(2)) + " steps max for " +
            sorted.length + " products)");
    }

    // ── Demo 8: BST ────────────────────────────────────────────────────────

    static void demoBST() {
        header("⑧ BST — Products Indexed by Price");
        System.out.println("  ► In-order traversal gives sorted-by-price output.");
        System.out.println("    Range queries: 'show flowers between ₹400–₹700'\n");

        bst.printInorder();

        System.out.println("\n  ► Range Query: Products between ₹400 and ₹700:");
        List<Product> range = bst.rangeQuery(400, 700);
        if (range.isEmpty()) System.out.println("  (none)");
        else { int i = 1; for (Product p : range) p.print(i++); }

        System.out.println("\n  ► Range Query: Products under ₹500 (budget blooms):");
        range = bst.rangeQuery(0, 499);
        if (range.isEmpty()) System.out.println("  (none)");
        else { int i = 1; for (Product p : range) p.print(i++); }

        System.out.println("\n  📊 Time Complexity: insert O(log n), search O(log n)");
        System.out.println("     In-order traversal: O(n) | Range query: O(log n + k)");
    }

    // ── Demo 9: Min-Heap ───────────────────────────────────────────────────

    static void demoMinHeap() {
        header("⑨ MIN-HEAP — Cheapest Flower Deals Priority Queue");
        System.out.println("  ► Always surfaces the cheapest flower at the top.");
        System.out.println("    Like a 'Best Deals' section on your website.\n");

        heap.printDeals();

        System.out.println("\n  ► Get cheapest (peek):");
        heap.getCheapest();

        System.out.println("\n  ► Extract cheapest (sold out — remove from deals):");
        heap.extractCheapest();

        System.out.println("\n  ► Add a flash sale item (₹199 Mini Rose):");
        heap.insert(new Product("pid_flash", "Mini Rose Bundle", "₹199", "Bouquet",
            "Flash sale — 6 mini roses at an unbeatable price!",
            "https://example.com/mini.jpg", "uid_s3", "Priya Singh"));

        System.out.println("\n  ► Updated deals:");
        heap.printDeals();

        System.out.println("\n  📊 Time Complexity: insert O(log n), getMin O(1), extractMin O(log n)");
    }

    // ── Demo 10: Graph ─────────────────────────────────────────────────────

    static void demoGraph() {
        header("⑩ GRAPH + BFS/DFS — Category Relationships");
        System.out.println("  ► Models how flower categories relate to each other.");
        System.out.println("    BFS: shortest path between categories.");
        System.out.println("    DFS: deep explore all related categories.\n");

        graph.printAdjacency();

        System.out.println();
        List<String> bfsResult = graph.bfs("Bouquet");
        System.out.println("  BFS visited order: " + bfsResult);

        List<String> dfsResult = graph.dfs("Bouquet");
        System.out.println("  DFS visited order: " + dfsResult);

        System.out.println("\n  ► Practical use: 'You bought a Bouquet — explore: "
            + graph.adj.get("Bouquet") + "'");
        System.out.println("\n  📊 Time Complexity: BFS O(V+E), DFS O(V+E)");
        System.out.println("     V=categories(nodes), E=relationships(edges)");
    }

