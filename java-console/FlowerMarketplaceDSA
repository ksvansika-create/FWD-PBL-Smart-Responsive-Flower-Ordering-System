    // ══════════════════════════════════════════════════════════════════════
    //  ① DOUBLY LINKED LIST — Product Catalog
    //  (Mirrors the Firestore collection ordered by createdAt desc)
    // ══════════════════════════════════════════════════════════════════════

    static class DLLNode {
        Product data;
        DLLNode prev, next;
        DLLNode(Product p) { data = p; }
    }

    static class ProductCatalog {
        DLLNode head, tail;
        int size = 0;

        // Add newest product to front (like Firestore orderBy createdAt desc)
        void addFront(Product p) {
            DLLNode node = new DLLNode(p);
            if (head == null) { head = tail = node; }
            else { node.next = head; head.prev = node; head = node; }
            size++;
        }

        // Remove product by id (like Firestore delete)
        boolean remove(String id) {
            for (DLLNode cur = head; cur != null; cur = cur.next) {
                if (cur.data.id.equals(id)) {
                    if (cur.prev != null) cur.prev.next = cur.next; else head = cur.next;
                    if (cur.next != null) cur.next.prev = cur.prev; else tail = cur.prev;
                    size--;
                    return true;
                }
            }
            return false;
        }

        // Traverse forward (home preview — first 3)
        List<Product> toList() {
            List<Product> list = new ArrayList<>();
            for (DLLNode cur = head; cur != null; cur = cur.next) list.add(cur.data);
            return list;
        }

        // Traverse backward (reverse: oldest first)
        List<Product> toListReverse() {
            List<Product> list = new ArrayList<>();
            for (DLLNode cur = tail; cur != null; cur = cur.prev) list.add(cur.data);
            return list;
        }

        void print() {
            System.out.println("\n  📋  Product Catalog — Doubly Linked List  (size=" + size + ")");
            System.out.println("  " + "─".repeat(70));
            int i = 1;
            for (DLLNode cur = head; cur != null; cur = cur.next) cur.data.print(i++);
        }
    }

