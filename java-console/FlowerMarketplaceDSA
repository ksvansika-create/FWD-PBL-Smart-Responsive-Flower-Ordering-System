    static class BrowsingStack {
        Deque<Product> stack = new ArrayDeque<>();

        void push(Product p) {
            stack.push(p);
            System.out.println("  📥 Pushed to history: " + p.name);
        }

        Product pop() {
            if (stack.isEmpty()) { System.out.println("  📭 History is empty."); return null; }
            Product p = stack.pop();
            System.out.println("  📤 Popped (undo / back): " + p.name);
            return p;
        }

        Product peek() {
            if (stack.isEmpty()) return null;
            System.out.println("  👁  Last viewed: " + stack.peek().name);
            return stack.peek();
        }

        void print() {
            System.out.println("\n  📚  Browsing History Stack  (top → bottom, size=" + stack.size() + ")");
            System.out.println("  " + "─".repeat(60));
            int i = 1;
            for (Product p : stack) {
                System.out.printf("  [%d] %-30s %s%n", i++, p.name, p.price);
            }
        }
    }

