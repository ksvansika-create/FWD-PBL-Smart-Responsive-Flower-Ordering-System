    // ── Demo 1: Doubly Linked List ─────────────────────────────────────────

    static void demoDLL() {
        header("① DOUBLY LINKED LIST — Product Catalog");
        System.out.println("  ► The catalog stores all listings in a DLL, newest first");
        System.out.println("    (same ordering as Firestore orderBy createdAt desc)\n");

        catalog.print();

        System.out.println("\n  ► Adding a new listing to the FRONT (newest):");
        Product newP = new Product("pid_8", "Jasmine Bouquet", "₹320", "Bouquet",
            "Fresh jasmine blooms tied with a satin ribbon.",
            "https://example.com/jasmine.jpg", "uid_s1", "Ananya Sharma");
        catalog.addFront(newP);
        catalog.print();

        System.out.println("\n  ► Removing that listing (like clicking 🗑 Delete on website):");
        catalog.remove("pid_8");
        catalog.print();

        System.out.println("\n  ► Traverse BACKWARD (oldest first, reverse DLL):");
        List<Product> rev = catalog.toListReverse();
        int i = 1;
        for (Product p : rev) p.print(i++);

        System.out.println("\n  📊 Time Complexity: addFront O(1), remove O(n), traverse O(n)");
    }

    // ── Demo 2: Stack ──────────────────────────────────────────────────────

    static void demoStack() {
        header("② STACK — Browsing History & Undo Last Listing");
        System.out.println("  ► Every product you click is pushed to the history stack");
        System.out.println("    (like your browser's back button)\n");

        history.print();

        System.out.println("\n  ► User views 'Lavender Garland':");
        history.push(catalog.toList().stream()
            .filter(p -> p.name.contains("Lavender")).findFirst()
            .orElse(catalog.head.data));

        System.out.println("\n  ► Peek — what was last viewed?");
        history.peek();

        System.out.println("\n  ► User presses BACK (pop):");
        history.pop();

        System.out.println("\n  ► Stack after back navigation:");
        history.print();

        System.out.println("\n  📊 Time Complexity: push O(1), pop O(1), peek O(1)");
    }

    // ── Demo 3: Queue ──────────────────────────────────────────────────────

    static void demoQueue() {
        header("③ QUEUE — Order Processing (FIFO Checkout)");
        System.out.println("  ► Orders placed on the payment page queue up here.");
        System.out.println("    First order placed = first order dispatched.\n");

        orders.print();

        System.out.println("\n  ► New order placed (UPI payment):");
        orders.enqueue("Rahul Mehta", "Mixed Spring Wreath", "₹849", "UPI (Paytm)");

        System.out.println("\n  ► Process next pending order:");
        orders.processNext();

        System.out.println("\n  ► Process ALL remaining orders:");
        orders.processAll();

        System.out.println("\n  📊 Time Complexity: enqueue O(1), dequeue O(1)");
    }

