        static int parsePrice(String p) {
            try { return Integer.parseInt(p.replaceAll("[^0-9]", "")); }
            catch (Exception e) { return 0; }
        }

        @Override public int compareTo(Product o) {
            return Integer.compare(this.priceInt, o.priceInt);
